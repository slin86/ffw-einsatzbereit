{
  "name": "einsatzbereit-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "TZ=Europe/Berlin vitest run",
    "test:watch": "TZ=Europe/Berlin vitest",
    "format": "prettier --write .",
    "lint": "prettier --check . && vue-tsc --noEmit",
    "coverage": "TZ=Europe/Berlin vitest run --coverage"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.1.0",
    "@fontsource/barlow-condensed": "^5.1.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-vue": "^5.1.0",
    "@vitest/coverage-v8": "^2.1.9",
    "@vue/tsconfig": "^0.5.1",
    "prettier": "^3.9.7",
    "typescript": "~5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.1.0"
  }
}
